# Sentinelle 974 — variables d'environnement (copier vers .env)
# Aucune donnée ne quitte la machine : tout est local.

# Ports exposés (bind 127.0.0.1 uniquement)
API_PORT=8090
DB_PORT=5433
PROM_PORT=9091

# Postgres
POSTGRES_PASSWORD=sentinelle

# Ollama local (déjà en service sur l'hôte, port 11434)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Modèle LLM local pour l'agent d'explication (léger, CPU-only, français)
SENTINELLE_LLM_MODEL=OpenLLM-France/Luciole-Instruct-1.1:1B

# Hôte audité (nom affiché dans les rapports)
SENTINELLE_HOST=localhost
